{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Run C",
      "type": "shell",
      "command": "gcc",
      "args": ["${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Compile current C file"
    },
    {
      "label": "Run C Executable",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}",
      "group": "test",
      "dependsOn": "Build and Run C",
      "problemMatcher": []
    }
  ]
}
